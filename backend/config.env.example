NODE_ENV=development
PORT=5000
DATABASE_LOCAL=mongodb://localhost:27017/pixelpocket
JWT_SECRET=
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90

# Public URL of the site, used in password reset links
FRONTEND_URL=http://localhost:3000

# SMTP for password reset emails. With EMAIL_HOST empty in development,
# emails are printed in the server log instead.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=PixelPocket <noreply@pixelpocket.local>

# S3-compatible file storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=pixelpocket
S3_ACCESS_KEY=
S3_SECRET_KEY=
