MONGO_PASSWORD=change-me

# MinIO file storage. The root account is only used to set MinIO up;
# the Backend uses the restricted S3_ACCESS_KEY / S3_SECRET_KEY account.
# Passwords and secret keys need at least 8 characters.
MINIO_ROOT_USER=pixelpocket-admin
MINIO_ROOT_PASSWORD=change-me-too
S3_BUCKET=pixelpocket
S3_ACCESS_KEY=pixelpocket-app
S3_SECRET_KEY=change-me-as-well

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90
WEB_PORT=8080

# development or production
NODE_ENV=development

# Public URL of the site, used in password reset links
FRONTEND_URL=http://localhost:8080

# SMTP settings for password reset emails. Leave EMAIL_HOST empty in development:
# the email is printed in the backend logs instead.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=PixelPocket <noreply@pixelpocket.local>
